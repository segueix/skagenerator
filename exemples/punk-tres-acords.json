    {
      "id": "punk-tres-acords-s2",
      "start": 4,
      "lyrics": "Tinc tres acords i res a perdre\nun amplificador que fa soroll\nla sala és petita i plena de gent\ni el bateria compta fins a quatre",
      "type": "verse",
      "bars": 8,
      "energy": 80
    },
    {
      "id": "punk-tres-acords-s3",
      "start": 12,
      "lyrics": "Un, dos, tres, quatre\ncrida amb mi\nun, dos, tres, quatre\navui som aquí",
      "type": "chorus",
      "bars": 8,
      "energy": 100
    },
    {
      "id": "punk-tres-acords-s4",
      "start": 20,
      "lyrics": "No sé tocar però tinc ganes\nles cordes trencades i el cor encès\nsi no t’agrada tanca la porta\nque nosaltres no callarem mai més",
      "type": "verse",
      "bars": 8,
      "energy": 80
