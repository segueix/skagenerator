    {
      "id": "ska-punk-a-cent-vuitanta-s2",
      "start": 4,
      "lyrics": "Corrent pel passeig amb el monopatí\nla policia xiula i no ens pot seguir\ntenim tres acords i una trompeta vella\ni tota la nit per fer-la sonar",
      "type": "verse",
      "bars": 8,
      "energy": 70
    },
    {
      "id": "ska-punk-a-cent-vuitanta-s3",
      "start": 12,
      "lyrics": "Més ràpid, més fort\nsalta amb nosaltres\nmés ràpid, més fort\nfins que caigui el sostre",
      "type": "chorus",
      "bars": 8,
      "energy": 95
    },
    {
