    {
      "id": "punk-estiu-pop-punk-s2",
      "start": 4,
      "lyrics": "Tota la colla a la furgoneta\ncap a la costa amb la ràdio a tope\ncrema solar i patates fregides\ni un estiu que no vull que s’acabi",
      "type": "verse",
      "bars": 8,
      "energy": 60
    },
    {
      "id": "punk-estiu-pop-punk-s3",
      "start": 12,
      "lyrics": "I si demà tot canvia\nrecorda aquesta nit",
      "type": "prechorus",
      "bars": 4,
      "energy": 80,
      "bpm": 180
    },
    {
      "id": "punk-estiu-pop-punk-s4",
      "start": 16,
      "lyrics": "Estiu, no te’n vagis\nqueda’t una mica més\nestiu, no te’n vagis\nque encara tinc tant per fer",
      "type": "chorus",
      "bars": 8,
      "energy": 95
    },
    {
      "id": "punk-estiu-pop-punk-s5",
      "start": 24,
      "lyrics": "Les nostres ombres llargues a la sorra\nel mar encara calent a les deu\nalgú ha trobat una guitarra vella\ni tothom canta sense saber la lletra",
      "type": "verse",
